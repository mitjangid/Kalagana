# Files included in the source distribution (sdist) on top of the package.
include LICENSE
include README.md
include .env.example
include pyproject.toml
include MANIFEST.in
include docs/api/README.md
include docs/festival-coverage.md

# API client import files (OpenAPI / Postman / Insomnia / Bruno).
recursive-include docs/api *.json *.md *.bru

# Developer tooling and tests (useful in the sdist, not installed).
recursive-include scripts *.py
recursive-include tests *.py

# Never ship caches, bytecode or local environment files.
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.egg-info
prune dist
prune build
prune .github
exclude .env
