# =============================================================================
# Kalagana configuration (.env.example)
# =============================================================================
# Copy this file to `.env` and edit as needed:
#
#     cp .env.example .env
#
# Every setting is OPTIONAL. Kalagana runs correctly with none of these set;
# each falls back to the default shown below. Values are read from the process
# environment first, then from `.env` in the working directory (a `.env` file
# never overrides a variable that is already set in the environment).
#
# Kalagana uses only the Python standard library, so there is no python-dotenv
# dependency: `.env` is parsed by kalagana/config.py.
#
# `.env` is git-ignored; `.env.example` is committed. Do not put secrets in
# `.env.example`.
# =============================================================================

# --- REST API server (used by `python -m kalagana.server` / `kalagana serve`) ---
# Bind address. Use 0.0.0.0 to expose on your LAN (no auth is provided!).
KALAGANA_HOST=127.0.0.1
# TCP port for the REST API.
KALAGANA_PORT=8765
# Log each request line to stderr. Set false for quiet operation.
KALAGANA_LOG_REQUESTS=true

# --- Default location ---------------------------------------------------------
# Used when a request or command omits an explicit location.
# Provide EITHER a built-in city key (see `kalagana cities`) ...
KALAGANA_CITY=delhi
# ... OR explicit coordinates. If both KALAGANA_LAT and KALAGANA_LON are set,
# they take precedence over KALAGANA_CITY. Longitude is EAST-positive.
# KALAGANA_LAT=28.6139
# KALAGANA_LON=77.2090
# IANA timezone. On Windows without the `tzdata` package, non-Indian zones fall
# back to a fixed standard offset (India is exact).
KALAGANA_TZ=Asia/Kolkata

# --- Astrology / calendar defaults -------------------------------------------
# Ayanamsa model: lahiri | raman | kp | yukteshwar | fagan_bradley
KALAGANA_AYANAMSA=lahiri
# Regional rule set: north | south | tamil | telugu | kannada | malayalam |
#                    bengali | odia | gujarati | marathi
KALAGANA_TRADITION=north
# Lunar month naming: purnimanta (North) | amanta (South)
KALAGANA_MONTH_SYSTEM=purnimanta
# Include the monthly observances (Ekadashi, Purnima, Amavasya, ...) by default.
KALAGANA_INCLUDE_MONTHLY=true
# Include the Islamic (Hijri) festivals (Eid al-Fitr, Eid al-Adha, Milad-un-Nabi,
# Muharram/Ashura, ...). These are computed from the tabular Islamic calendar and
# may differ by 1-2 days from the local crescent sighting.
KALAGANA_INCLUDE_ISLAMIC=true
# Include the fixed Gregorian-date observances: national holidays (Republic Day,
# Independence Day, Gandhi Jayanti) and the commemorative/awareness days
# (National Science Day, Teachers' Day, ...).
KALAGANA_INCLUDE_FIXED=true

# --- Behaviour ----------------------------------------------------------------
# How many years ahead `find` searches before giving up.
KALAGANA_FIND_YEARS=3
# Preferred name language: en | hi | ta | te | kn | ml | bn | gu
# (only `en` is populated today; reserved for translated names.)
KALAGANA_LANG=hi

# --- Loading behaviour --------------------------------------------------------
# Path to the .env file to read (relative to the working directory).
KALAGANA_ENV_FILE=.env
# When true, invalid values raise instead of silently falling back to defaults.
KALAGANA_STRICT=false
