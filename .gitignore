# =============================================================================
# Kalagana - Git ignore rules
# =============================================================================
# Covers: all hidden/dot folders, AI coding-assistant folders, and common
# editor / OS / Python build tool artifacts.
# =============================================================================

# --- ALL hidden (dot-prefixed) directories -----------------------------------
# Matches any folder whose name starts with a dot, at any depth
# (e.g. .freebuff, .kilo, .vscode, .idea, .venv, ...).
# The trailing slash restricts this to folders, so dot FILES such as
# .gitignore are still tracked.
.*/

# --- AI coding assistant / agent tool configuration --------------------------
# (redundant with ".*/" above, but kept explicit for clarity & intent)
.freebuff/
.freebuff.json
.kilo/
.kilocode/
.continue/
.claude/
.claude.json
.cursor/
.cursorrules
.cursorignore
.windsurf/
.codeium/
.cody/
.tabnine/
.aider*
.trae/
.qodo/
.roo/
.amazonq/
.kiro/
.agent/
.agents/
.opencode/
.factory/
.goose/
.gemini/
.gemini-cli/
.augment/
.tessl/
.pieces/
.llm/
.plandex/
.copilot/

# --- Local-only documentation / specs ----------------------------------------
# Working prompts / scratch specs are kept locally; the published docs (the API
# reference, festival coverage, and the app plans/sprints) are versioned.
docs/*
!docs/README.md
!docs/festival-coverage.md
!docs/api/
!docs/api/**

# --- GitHub automation -------------------------------------------------------
# .github/ is a real project folder (CI, releases) -- keep it despite ".*/" above.
!.github/
!.github/**

# --- Editor / IDE configuration ----------------------------------------------
.vscode/
.idea/
*.iml
nbproject/
*.swp
*.swo
*~

# --- Operating system files --------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# --- Python bytecode / caches ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Python build / packaging artifacts --------------------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
virtualenv/

# --- Test / lint / type-check caches -----------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/

# --- Local environment / secrets ---------------------------------------------
# Real environment files are local-only; the annotated template is committed.
.env
.env.*
!.env.example

# --- Logs / temp -------------------------------------------------------------
*.log
*.tmp